 484:Core/Src/ow.c **** /**
 485:Core/Src/ow.c ****  * @brief Start a 1-Wire transfer on the bus.
 486:Core/Src/ow.c ****  * @param[in] handle: Pointer to the 1-Wire handle.
 487:Core/Src/ow.c ****  * @retval OW_ERR_NONE on success, or error code (OW_ERR_BUSY, OW_ERR_BUS).
 488:Core/Src/ow.c ****  */
 489:Core/Src/ow.c **** ow_err_t ow_start(ow_t *handle)
 490:Core/Src/ow.c **** {
 491:Core/Src/ow.c ****   ow_err_t ow_err = OW_ERR_NONE;
 492:Core/Src/ow.c ****   assert_param(handle != NULL);
 493:Core/Src/ow.c **** 
 494:Core/Src/ow.c ****   do
 495:Core/Src/ow.c ****   {
 496:Core/Src/ow.c ****     /* Ensure bus is idle before starting transfer */
 497:Core/Src/ow.c ****     if (handle->state != OW_STATE_IDLE)
 498:Core/Src/ow.c ****     {
 499:Core/Src/ow.c ****       ow_err = OW_ERR_BUSY;
 500:Core/Src/ow.c ****       break;
 501:Core/Src/ow.c ****     }
 502:Core/Src/ow.c **** 
 503:Core/Src/ow.c ****     /* Pull bus high and check if line is idle */
 504:Core/Src/ow.c ****     ow_write_bit(handle, true);
 505:Core/Src/ow.c ****     if (!ow_read_bit(handle))
 506:Core/Src/ow.c ****     {
 507:Core/Src/ow.c ****       ow_err = OW_ERR_BUS;
 508:Core/Src/ow.c ****       break;
 509:Core/Src/ow.c ****     }
 510:Core/Src/ow.c **** 
 511:Core/Src/ow.c ****     /* Clear timer interrupt and reset internal buffer */
 512:Core/Src/ow.c ****     __HAL_TIM_CLEAR_IT(handle->config.tim_handle, 0xFFFFFFFFUL);
 513:Core/Src/ow.c ****     memset(&handle->buf, 0, sizeof(ow_buf_t));
 514:Core/Src/ow.c **** 
 515:Core/Src/ow.c ****     /* Configure timer for reset detection */
 516:Core/Src/ow.c ****     __HAL_TIM_SET_COUNTER(handle->config.tim_handle, 0);
 517:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST_DET - 1);
 518:Core/Src/ow.c ****     HAL_TIM_Base_Start_IT(handle->config.tim_handle);
 519:Core/Src/ow.c **** 
 520:Core/Src/ow.c ****   } while (0);
 521:Core/Src/ow.c **** 
ARM GAS  /tmp/cc1AzyH1.s 			page 12


 522:Core/Src/ow.c ****   return ow_err;
 523:Core/Src/ow.c **** }
 524:Core/Src/ow.c **** 
 525:Core/Src/ow.c **** /*************************************************************************************************/
 526:Core/Src/ow.c **** /**
 527:Core/Src/ow.c ****  * @brief Stop 1-Wire transfer and release the bus.
 528:Core/Src/ow.c ****  * @param[in] handle Pointer to the 1-Wire handle.
 529:Core/Src/ow.c ****  */
 530:Core/Src/ow.c **** void ow_stop(ow_t *handle)
 531:Core/Src/ow.c **** {
 532:Core/Src/ow.c ****   assert_param(handle != NULL);
 533:Core/Src/ow.c **** 
 534:Core/Src/ow.c ****   /* Stop timer interrupts */
 535:Core/Src/ow.c ****   HAL_TIM_Base_Stop_IT(handle->config.tim_handle);
 536:Core/Src/ow.c **** 
 537:Core/Src/ow.c ****   /* Release bus (set high) */
 538:Core/Src/ow.c ****   ow_write_bit(handle, true);
 539:Core/Src/ow.c **** 
 540:Core/Src/ow.c ****   /* Set state to idle */
 541:Core/Src/ow.c ****   handle->state = OW_STATE_IDLE;
 542:Core/Src/ow.c **** 
 543:Core/Src/ow.c ****   /* Call user callback if registered */
 544:Core/Src/ow.c ****   if (handle->config.done_cb != NULL)
 545:Core/Src/ow.c ****   {
 546:Core/Src/ow.c ****     handle->config.done_cb(handle->error);
 547:Core/Src/ow.c ****   }
 548:Core/Src/ow.c **** }
 549:Core/Src/ow.c **** 
 550:Core/Src/ow.c **** /*************************************************************************************************/
 551:Core/Src/ow.c **** /**
 552:Core/Src/ow.c ****  * @brief 1-Wire state machine: handle transfer phases (reset, write, read).
 553:Core/Src/ow.c ****  * @param[in] handle Pointer to the 1-Wire handle.
 554:Core/Src/ow.c ****  */
 555:Core/Src/ow.c **** __STATIC_FORCEINLINE void ow_state_xfer(ow_t *handle)
 556:Core/Src/ow.c **** {
 557:Core/Src/ow.c ****   assert_param(handle != NULL);
 558:Core/Src/ow.c **** 
 559:Core/Src/ow.c ****   switch (handle->buf.bit_ph)
 560:Core/Src/ow.c ****   {
 561:Core/Src/ow.c ****     /************ Reset phase: pull bus low ************/
 562:Core/Src/ow.c ****     case 0:
 563:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST - 1);
 564:Core/Src/ow.c ****       ow_write_bit(handle, false);
 565:Core/Src/ow.c ****       handle->buf.bit_ph++;
 566:Core/Src/ow.c ****       break;
 567:Core/Src/ow.c **** 
 568:Core/Src/ow.c ****     /************ Reset phase: release bus (high) ************/
 569:Core/Src/ow.c ****     case 1:
 570:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST_DET - 1);
 571:Core/Src/ow.c ****       ow_write_bit(handle, true);
 572:Core/Src/ow.c ****       handle->buf.bit_ph++;
 573:Core/Src/ow.c ****       break;
 574:Core/Src/ow.c **** 
 575:Core/Src/ow.c ****     /************ Reset phase: check presence pulse ************/
 576:Core/Src/ow.c ****     case 2:
 577:Core/Src/ow.c ****       if (ow_read_bit(handle) != 0)
 578:Core/Src/ow.c ****       {
ARM GAS  /tmp/cc1AzyH1.s 			page 13


 579:Core/Src/ow.c ****         handle->error = OW_ERR_RESET;
 580:Core/Src/ow.c ****         ow_stop(handle);
 581:Core/Src/ow.c ****       }
 582:Core/Src/ow.c ****       else
 583:Core/Src/ow.c ****       {
 584:Core/Src/ow.c ****         __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST - 1);
 585:Core/Src/ow.c ****         handle->buf.bit_ph++;
 586:Core/Src/ow.c ****       }
 587:Core/Src/ow.c ****       break;
 588:Core/Src/ow.c **** 
 589:Core/Src/ow.c ****     /************ Writing, phase 1: pull low ************/
 590:Core/Src/ow.c ****     case 3:
 591:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle,
 592:Core/Src/ow.c ****         (handle->buf.data[handle->buf.byte_idx] & (1 << handle->buf.bit_idx)) ? OW_TIM_WRITE_LOW - 
 593:Core/Src/ow.c ****       ow_write_bit(handle, false);
 594:Core/Src/ow.c ****       handle->buf.bit_ph++;
 595:Core/Src/ow.c ****       break;
 596:Core/Src/ow.c **** 
 597:Core/Src/ow.c ****     /************ Writing, phase 2: release bus ************/
 598:Core/Src/ow.c ****     case 4:
 599:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle,
 600:Core/Src/ow.c ****         (handle->buf.data[handle->buf.byte_idx] & (1 << handle->buf.bit_idx)) ? OW_TIM_WRITE_HIGH -
 601:Core/Src/ow.c ****       ow_write_bit(handle, true);
 602:Core/Src/ow.c ****       handle->buf.bit_idx++;
 603:Core/Src/ow.c **** 
 604:Core/Src/ow.c ****       /* Move to next byte or reading phase */
 605:Core/Src/ow.c ****       if (handle->buf.bit_idx == 8)
 606:Core/Src/ow.c ****       {
 607:Core/Src/ow.c ****         handle->buf.bit_idx = 0;
 608:Core/Src/ow.c ****         handle->buf.byte_idx++;
 609:Core/Src/ow.c ****         if (handle->buf.byte_idx == handle->buf.write_len)
 610:Core/Src/ow.c ****         {
 611:Core/Src/ow.c ****           if (handle->buf.read_len > 0)
 612:Core/Src/ow.c ****           {
 613:Core/Src/ow.c ****             /* Start reading phase */
 614:Core/Src/ow.c ****             handle->buf.bit_ph = 5;
 615:Core/Src/ow.c ****             handle->buf.byte_idx = 0;
 616:Core/Src/ow.c ****           }
 617:Core/Src/ow.c ****           else
 618:Core/Src/ow.c ****           {
 619:Core/Src/ow.c ****             /* Writing complete, no reading */
 620:Core/Src/ow.c ****             handle->state = OW_STATE_DONE;
 621:Core/Src/ow.c ****           }
 622:Core/Src/ow.c ****         }
 623:Core/Src/ow.c ****         else
 624:Core/Src/ow.c ****         {
 625:Core/Src/ow.c ****           /* Continue writing next byte */
 626:Core/Src/ow.c ****           handle->buf.bit_ph = 3;
 627:Core/Src/ow.c ****         }
 628:Core/Src/ow.c ****       }
 629:Core/Src/ow.c ****       else
 630:Core/Src/ow.c ****       {
 631:Core/Src/ow.c ****         /* Continue writing next bit */
 632:Core/Src/ow.c ****         handle->buf.bit_ph = 3;
 633:Core/Src/ow.c ****       }
 634:Core/Src/ow.c ****       break;
 635:Core/Src/ow.c **** 
ARM GAS  /tmp/cc1AzyH1.s 			page 14


 636:Core/Src/ow.c ****     /************ Reading, phase 1: pull low ************/
 637:Core/Src/ow.c ****     case 5:
 638:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_LOW - 1);
 639:Core/Src/ow.c ****       ow_write_bit(handle, false);
 640:Core/Src/ow.c ****       handle->buf.bit_ph++;
 641:Core/Src/ow.c ****       break;
 642:Core/Src/ow.c **** 
 643:Core/Src/ow.c ****     /************ Reading, phase 2: release bus ************/
 644:Core/Src/ow.c ****     case 6:
 645:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_SAMPLE - 1);
 646:Core/Src/ow.c ****       ow_write_bit(handle, true);
 647:Core/Src/ow.c ****       handle->buf.bit_ph++;
 648:Core/Src/ow.c ****       break;
 649:Core/Src/ow.c **** 
 650:Core/Src/ow.c ****     /************ Reading, phase 3: sample bus ************/
 651:Core/Src/ow.c ****     case 7:
 652:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_HIGH - 1);
 653:Core/Src/ow.c ****       if (ow_read_bit(handle))
 654:Core/Src/ow.c ****       {
 655:Core/Src/ow.c ****         handle->buf.data[handle->buf.write_len + handle->buf.byte_idx] |= (1 << handle->buf.bit_idx
 656:Core/Src/ow.c ****       }
 657:Core/Src/ow.c **** 
 658:Core/Src/ow.c ****       /* Update bit/byte counters */
 659:Core/Src/ow.c ****       handle->buf.bit_ph = 5;
 660:Core/Src/ow.c ****       handle->buf.bit_idx++;
 661:Core/Src/ow.c ****       if (handle->buf.bit_idx == 8)
 662:Core/Src/ow.c ****       {
 663:Core/Src/ow.c ****         handle->buf.bit_idx = 0;
 664:Core/Src/ow.c ****         handle->buf.byte_idx++;
 665:Core/Src/ow.c ****         if (handle->buf.byte_idx == handle->buf.read_len)
 666:Core/Src/ow.c ****         {
 667:Core/Src/ow.c **** #if (OW_MAX_DEVICE == 1)
 668:Core/Src/ow.c ****           /* Single device: verify ROM ID if READ_ROM command */
 669:Core/Src/ow.c ****           if (handle->buf.data[0] == OW_CMD_READ_ROM)
 670:Core/Src/ow.c ****           {
 671:Core/Src/ow.c ****             if (ow_crc(&handle->buf.data[1], 7) == handle->buf.data[7])
 672:Core/Src/ow.c ****             {
 673:Core/Src/ow.c ****               memcpy(handle->rom_id[0].array, &handle->buf.data[1], 8);
 674:Core/Src/ow.c ****               handle->error = OW_ERR_NONE;
 675:Core/Src/ow.c ****             }
 676:Core/Src/ow.c ****             else
 677:Core/Src/ow.c ****             {
 678:Core/Src/ow.c ****               handle->error = OW_ERR_ROM_ID;
 679:Core/Src/ow.c ****             }
 680:Core/Src/ow.c ****           }
 681:Core/Src/ow.c **** #endif
 682:Core/Src/ow.c ****           handle->state = OW_STATE_DONE;
 683:Core/Src/ow.c ****         }
 684:Core/Src/ow.c ****       }
 685:Core/Src/ow.c ****       break;
 686:Core/Src/ow.c **** 
 687:Core/Src/ow.c ****     default:
 688:Core/Src/ow.c ****       break;
 689:Core/Src/ow.c ****   }
 690:Core/Src/ow.c **** }
 691:Core/Src/ow.c **** 
 692:Core/Src/ow.c **** #if (OW_MAX_DEVICE > 1)
ARM GAS  /tmp/cc1AzyH1.s 			page 15


