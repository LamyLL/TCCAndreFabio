 398:Core/Src/ow.c ****     handle->buf.data[9] = fn_cmd;
 399:Core/Src/ow.c **** 
 400:Core/Src/ow.c ****     /* Copy user data if provided */
 401:Core/Src/ow.c ****     if (w_data != NULL)
 402:Core/Src/ow.c ****     {
 403:Core/Src/ow.c ****       for (uint16_t idx = 0; idx < w_len; idx++)
 404:Core/Src/ow.c ****       {
 405:Core/Src/ow.c ****         handle->buf.data[10 + idx] = w_data[idx];
 406:Core/Src/ow.c ****       }
