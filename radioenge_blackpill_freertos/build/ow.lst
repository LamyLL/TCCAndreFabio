 109:Core/Src/ow.c **** /**
 110:Core/Src/ow.c ****  * @brief Handle 1-Wire timer callback and call state handlers.
 111:Core/Src/ow.c ****  * @param[in] handle: Pointer to the 1-Wire handle.
 112:Core/Src/ow.c ****  */
 113:Core/Src/ow.c **** void ow_callback(ow_t *handle)
 114:Core/Src/ow.c **** {
 115:Core/Src/ow.c ****   assert_param(handle != NULL);
 116:Core/Src/ow.c **** 
 117:Core/Src/ow.c ****   switch (handle->state)
 118:Core/Src/ow.c ****   {
 119:Core/Src/ow.c ****     /* Ongoing data transfer */
 120:Core/Src/ow.c ****     case OW_STATE_XFER:       
 121:Core/Src/ow.c ****       ow_state_xfer(handle);
 122:Core/Src/ow.c ****       break;
ARM GAS  /tmp/cc1AzyH1.s 			page 5


 123:Core/Src/ow.c **** 
 124:Core/Src/ow.c **** #if (OW_MAX_DEVICE > 1)
 125:Core/Src/ow.c ****     /* ROM search operation */
 126:Core/Src/ow.c ****     case OW_STATE_SEARCH:     
 127:Core/Src/ow.c ****       ow_state_search(handle);
 128:Core/Src/ow.c ****       break;
 129:Core/Src/ow.c **** #endif
 130:Core/Src/ow.c **** 
 131:Core/Src/ow.c ****     /* Any invalid state -> stop */
 132:Core/Src/ow.c ****     default:                  
 133:Core/Src/ow.c ****       ow_stop(handle);
 134:Core/Src/ow.c ****       break;
 135:Core/Src/ow.c ****   }
 136:Core/Src/ow.c **** }
 137:Core/Src/ow.c **** 
