 267:Core/Src/ow.c **** /**
 268:Core/Src/ow.c ****  * @brief Transfer a command and optional data to/from a specific 1-Wire device by Skip ROM.
 269:Core/Src/ow.c ****  * @param[in] handle Pointer to the 1-Wire handle structure.
 270:Core/Src/ow.c ****  * @param[in] fn_cmd Function or command byte to send.
 271:Core/Src/ow.c ****  * @param[in] w_data Pointer to the data buffer to write (can be NULL if w_len is 0).
 272:Core/Src/ow.c ****  * @param[in] w_len Number of bytes to write from w_data (can be 0).
 273:Core/Src/ow.c ****  * @param[in] r_len Number of bytes to read (can be 0).
 274:Core/Src/ow.c ****  * @retval Error code (ow_err_t).
 275:Core/Src/ow.c ****  */
 276:Core/Src/ow.c **** ow_err_t ow_xfer(ow_t *handle, uint8_t fn_cmd, const uint8_t *w_data, uint16_t w_len, uint16_t r_le
 277:Core/Src/ow.c **** {
 278:Core/Src/ow.c ****   assert_param(handle != NULL);
 279:Core/Src/ow.c **** 
 280:Core/Src/ow.c ****   do
 281:Core/Src/ow.c ****   {
 282:Core/Src/ow.c ****     /* Check if w_data is NULL but requested write data */
 283:Core/Src/ow.c ****     if ((w_data == NULL) && (w_len > 0))
 284:Core/Src/ow.c ****     {
 285:Core/Src/ow.c ****       handle->error = OW_ERR_LEN;
 286:Core/Src/ow.c ****       ow_stop(handle);
 287:Core/Src/ow.c ****       break;
 288:Core/Src/ow.c ****     }
 289:Core/Src/ow.c **** 
 290:Core/Src/ow.c ****     /* Check if requested read/read length exceeds buffer */
 291:Core/Src/ow.c ****     if (w_len + r_len > OW_MAX_DATA_LEN)
 292:Core/Src/ow.c ****     {
 293:Core/Src/ow.c ****       handle->error = OW_ERR_LEN;
ARM GAS  /tmp/cc1AzyH1.s 			page 8


 294:Core/Src/ow.c ****       ow_stop(handle);
 295:Core/Src/ow.c ****       break;
 296:Core/Src/ow.c ****     }
 297:Core/Src/ow.c **** 
 298:Core/Src/ow.c ****     /* Start 1-Wire communication */
 299:Core/Src/ow.c ****     handle->error = ow_start(handle);
 300:Core/Src/ow.c ****     if (handle->error != OW_ERR_NONE)
 301:Core/Src/ow.c ****     {
