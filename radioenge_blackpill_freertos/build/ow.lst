 386:Core/Src/ow.c **** 
 387:Core/Src/ow.c ****     /* Prepare transfer buffer */
 388:Core/Src/ow.c ****     handle->state = OW_STATE_XFER;
 389:Core/Src/ow.c ****     
 390:Core/Src/ow.c ****     /* Select device by ROM */
 391:Core/Src/ow.c ****     handle->buf.data[0] = OW_CMD_MATCH_ROM;
 392:Core/Src/ow.c ****     for (uint8_t idx = 0; idx < 8; idx++)
 393:Core/Src/ow.c ****     {
 394:Core/Src/ow.c ****       handle->buf.data[1 + idx] = handle->rom_id[rom_id].array[idx];
 395:Core/Src/ow.c ****     }
 396:Core/Src/ow.c ****     
