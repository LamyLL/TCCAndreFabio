 694:Core/Src/ow.c **** /**
 695:Core/Src/ow.c ****  * @brief  1-Wire ROM search state machine.
 696:Core/Src/ow.c ****  * @param  handle: Pointer to 1-Wire handle.
 697:Core/Src/ow.c ****  * @retval None
 698:Core/Src/ow.c ****  *
 699:Core/Src/ow.c ****  * @details
 700:Core/Src/ow.c ****  * Implements non-blocking search, handles reset, read/write bits,
 701:Core/Src/ow.c ****  * resolves discrepancies, stores found ROMs, and sets state done.
 702:Core/Src/ow.c ****  */
 703:Core/Src/ow.c **** __STATIC_FORCEINLINE void ow_state_search(ow_t *handle)
 704:Core/Src/ow.c **** {
 705:Core/Src/ow.c ****   assert_param(handle != NULL);
 706:Core/Src/ow.c **** 
 707:Core/Src/ow.c ****   switch (handle->buf.bit_ph)
 708:Core/Src/ow.c ****   {
 709:Core/Src/ow.c ****   /************ Reset phase: pull bus low ************/
 710:Core/Src/ow.c ****   case 0:
 711:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST - 1);
 712:Core/Src/ow.c ****     ow_write_bit(handle, false);
 713:Core/Src/ow.c ****     handle->buf.bit_ph++;
 714:Core/Src/ow.c ****     break;
 715:Core/Src/ow.c **** 
 716:Core/Src/ow.c ****     /************ Reset phase: release bus (high) ************/
 717:Core/Src/ow.c ****   case 1:
 718:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST_DET - 1);
 719:Core/Src/ow.c ****     ow_write_bit(handle, true);
 720:Core/Src/ow.c ****     handle->buf.bit_ph++;
 721:Core/Src/ow.c ****     break;
 722:Core/Src/ow.c **** 
 723:Core/Src/ow.c ****   /************ Reset phase: check presence pulse ************/
 724:Core/Src/ow.c ****   case 2:
 725:Core/Src/ow.c ****     if (ow_read_bit(handle) != 0)
 726:Core/Src/ow.c ****     {
 727:Core/Src/ow.c ****       handle->error = OW_ERR_RESET;
 728:Core/Src/ow.c ****       ow_stop(handle);
 729:Core/Src/ow.c ****     }
 730:Core/Src/ow.c ****     else
 731:Core/Src/ow.c ****     {
 732:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_RST - 1);
 733:Core/Src/ow.c ****       handle->buf.bit_ph++;
 734:Core/Src/ow.c ****     }
 735:Core/Src/ow.c ****     break;
 736:Core/Src/ow.c **** 
 737:Core/Src/ow.c ****   /************ Writing, phase 1: pull low ************/
 738:Core/Src/ow.c ****   case 3:
 739:Core/Src/ow.c ****     if (handle->buf.data[0] & (1 << handle->buf.bit_idx))
 740:Core/Src/ow.c ****     {
 741:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_LOW - 1);
 742:Core/Src/ow.c ****     }
 743:Core/Src/ow.c ****     else
 744:Core/Src/ow.c ****     {
 745:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_HIGH - 1);
 746:Core/Src/ow.c ****     }
 747:Core/Src/ow.c ****     ow_write_bit(handle, false);
 748:Core/Src/ow.c ****     handle->buf.bit_ph++;
 749:Core/Src/ow.c ****     break;
ARM GAS  /tmp/cc1AzyH1.s 			page 16


 750:Core/Src/ow.c **** 
 751:Core/Src/ow.c ****   /************ Writing, phase 2: release bus ************/
 752:Core/Src/ow.c ****   case 4:
 753:Core/Src/ow.c ****     if (handle->buf.data[0] & (1 << handle->buf.bit_idx))
 754:Core/Src/ow.c ****     {
 755:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_HIGH - 1);
 756:Core/Src/ow.c ****     }
 757:Core/Src/ow.c ****     else
 758:Core/Src/ow.c ****     {
 759:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_LOW - 1);
 760:Core/Src/ow.c ****     }
 761:Core/Src/ow.c ****     ow_write_bit(handle, true);
 762:Core/Src/ow.c ****     handle->buf.bit_idx++;
 763:Core/Src/ow.c **** 
 764:Core/Src/ow.c ****     /* command complete */
 765:Core/Src/ow.c ****     if (handle->buf.bit_idx == 8)
 766:Core/Src/ow.c ****     {
 767:Core/Src/ow.c ****       handle->buf.bit_idx = 0;
 768:Core/Src/ow.c ****       /* Start reading phase */
 769:Core/Src/ow.c ****       handle->buf.bit_ph = 5;
 770:Core/Src/ow.c ****     }
 771:Core/Src/ow.c ****     else
 772:Core/Src/ow.c ****     {
 773:Core/Src/ow.c ****       /* Writing next command bit */
 774:Core/Src/ow.c ****       handle->buf.bit_ph = 3;
 775:Core/Src/ow.c ****     }
 776:Core/Src/ow.c ****     break;
 777:Core/Src/ow.c **** 
 778:Core/Src/ow.c ****   /************ Reading, phase 1: pull low ************/
 779:Core/Src/ow.c ****   case 5:
 780:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_LOW - 1);
 781:Core/Src/ow.c ****     ow_write_bit(handle, false);
 782:Core/Src/ow.c ****     handle->buf.bit_ph++;
 783:Core/Src/ow.c ****     break;
 784:Core/Src/ow.c **** 
 785:Core/Src/ow.c ****   /************ reading bit, phase 2 ************/
 786:Core/Src/ow.c ****   case 6:
 787:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_SAMPLE - 1);
 788:Core/Src/ow.c ****     ow_write_bit(handle, true);
 789:Core/Src/ow.c ****     handle->buf.bit_ph++;
 790:Core/Src/ow.c ****     break;
 791:Core/Src/ow.c **** 
 792:Core/Src/ow.c ****   /************ reading bit, phase 3 ************/
 793:Core/Src/ow.c ****   case 7:
 794:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_HIGH - 1);
 795:Core/Src/ow.c ****     if (ow_read_bit(handle))
 796:Core/Src/ow.c ****     {
 797:Core/Src/ow.c ****       handle->search.val = OW_VAL_1;
 798:Core/Src/ow.c ****     }
 799:Core/Src/ow.c ****     else
 800:Core/Src/ow.c ****     {
 801:Core/Src/ow.c ****       handle->search.val = OW_VAL_DIFF;
 802:Core/Src/ow.c ****     }
 803:Core/Src/ow.c ****     handle->buf.bit_ph++;
 804:Core/Src/ow.c ****     break;
 805:Core/Src/ow.c **** 
 806:Core/Src/ow.c ****   /************ reading complement bit, phase 1 ************/
ARM GAS  /tmp/cc1AzyH1.s 			page 17


 807:Core/Src/ow.c ****   case 8:
 808:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_LOW - 1);
 809:Core/Src/ow.c ****     ow_write_bit(handle, false);
 810:Core/Src/ow.c ****     handle->buf.bit_ph++;
 811:Core/Src/ow.c ****     break;
 812:Core/Src/ow.c **** 
 813:Core/Src/ow.c ****   /************ Reading, phase 2: release bus ************/
 814:Core/Src/ow.c ****   case 9:
 815:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_SAMPLE - 1);
 816:Core/Src/ow.c ****     ow_write_bit(handle, true);
 817:Core/Src/ow.c ****     handle->buf.bit_ph++;
 818:Core/Src/ow.c ****     break;
 819:Core/Src/ow.c **** 
 820:Core/Src/ow.c ****   /************ Reading, phase 3: sample bus ************/
 821:Core/Src/ow.c ****   case 10:
 822:Core/Src/ow.c ****     __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_READ_HIGH - 1);
 823:Core/Src/ow.c ****     if (ow_read_bit(handle))
 824:Core/Src/ow.c ****     {
 825:Core/Src/ow.c ****       handle->search.val |= OW_VAL_0;
 826:Core/Src/ow.c ****     }
 827:Core/Src/ow.c ****     handle->buf.bit_ph++;
 828:Core/Src/ow.c **** 
 829:Core/Src/ow.c ****     /* resolve discrepancy */
 830:Core/Src/ow.c ****     /* Dallas counts bits 1..64 */
 831:Core/Src/ow.c ****     uint8_t bit_number = handle->buf.bit_idx + 1;
 832:Core/Src/ow.c ****     if (handle->search.val == OW_VAL_DIFF)
 833:Core/Src/ow.c ****     {
 834:Core/Src/ow.c ****       uint8_t bit_choice = 0;
 835:Core/Src/ow.c ****       if (bit_number < handle->search.last_discrepancy)
 836:Core/Src/ow.c ****       {
 837:Core/Src/ow.c ****         /* repeat previous path */
 838:Core/Src/ow.c ****         bit_choice = (handle->search.rom_id[handle->buf.bit_idx / 8] >> (handle->buf.bit_idx % 8)) 
 839:Core/Src/ow.c ****       }
 840:Core/Src/ow.c ****       else if (bit_number == handle->search.last_discrepancy)
 841:Core/Src/ow.c ****       {
 842:Core/Src/ow.c ****         /* this time choose 1 */
 843:Core/Src/ow.c ****         bit_choice = 1;
 844:Core/Src/ow.c ****       }
 845:Core/Src/ow.c ****       else
 846:Core/Src/ow.c ****       {
 847:Core/Src/ow.c ****         /* choose 0 and remember as last zero */
 848:Core/Src/ow.c ****         bit_choice = 0;
 849:Core/Src/ow.c ****         handle->search.last_zero = bit_number;
 850:Core/Src/ow.c ****       }
 851:Core/Src/ow.c ****       handle->search.val = bit_choice ? OW_VAL_1 : OW_VAL_0;
 852:Core/Src/ow.c ****     }
 853:Core/Src/ow.c ****     else if (handle->search.val == OW_VAL_ERR)
 854:Core/Src/ow.c ****     {
 855:Core/Src/ow.c ****       handle->error = OW_ERR_ROM_ID;
 856:Core/Src/ow.c ****       ow_stop(handle);
 857:Core/Src/ow.c ****     }
 858:Core/Src/ow.c ****     break;
 859:Core/Src/ow.c **** 
 860:Core/Src/ow.c ****   /************ Writing selected bit, phase 1: pull low ************/
 861:Core/Src/ow.c ****   case 11:
 862:Core/Src/ow.c ****     if (handle->search.val == OW_VAL_1)
 863:Core/Src/ow.c ****     {
ARM GAS  /tmp/cc1AzyH1.s 			page 18


 864:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_LOW - 1);
 865:Core/Src/ow.c ****       handle->search.rom_id[handle->buf.bit_idx / 8] |= (1 << (handle->buf.bit_idx % 8));
 866:Core/Src/ow.c ****     }
 867:Core/Src/ow.c ****     else
 868:Core/Src/ow.c ****     {
 869:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_HIGH - 1);
 870:Core/Src/ow.c ****     }
 871:Core/Src/ow.c ****     ow_write_bit(handle, false);
 872:Core/Src/ow.c ****     handle->buf.bit_ph++;
 873:Core/Src/ow.c ****     break;
 874:Core/Src/ow.c **** 
 875:Core/Src/ow.c ****   /************ Writing selected bit, phase 2: release bus ************/
 876:Core/Src/ow.c ****   case 12:
 877:Core/Src/ow.c ****     if (handle->search.val == OW_VAL_1)
 878:Core/Src/ow.c ****     {
 879:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_HIGH - 1);
 880:Core/Src/ow.c ****     }
 881:Core/Src/ow.c ****     else
 882:Core/Src/ow.c ****     {
 883:Core/Src/ow.c ****       __HAL_TIM_SET_AUTORELOAD(handle->config.tim_handle, OW_TIM_WRITE_LOW - 1);
 884:Core/Src/ow.c ****     }
 885:Core/Src/ow.c ****     ow_write_bit(handle, true);
 886:Core/Src/ow.c ****     handle->buf.bit_idx++;
 887:Core/Src/ow.c ****     if (handle->buf.bit_idx == 64)
 888:Core/Src/ow.c ****     {
 889:Core/Src/ow.c ****       /* full ROM read */
 890:Core/Src/ow.c ****       handle->buf.bit_idx = 0;
 891:Core/Src/ow.c ****       handle->buf.bit_ph = 0;
 892:Core/Src/ow.c ****       if (ow_crc(handle->search.rom_id, 7) == handle->search.rom_id[7])
 893:Core/Src/ow.c ****       {
 894:Core/Src/ow.c ****         /* ROM ID Filter not enabled */
 895:Core/Src/ow.c ****         if (handle->rom_id_filter == 0)
 896:Core/Src/ow.c ****         {
 897:Core/Src/ow.c ****           memcpy(&handle->rom_id[handle->rom_id_found], handle->search.rom_id, 8);
 898:Core/Src/ow.c ****           handle->rom_id_found++;
 899:Core/Src/ow.c ****         }
 900:Core/Src/ow.c ****         /* Selected ROM ID Filter */
 901:Core/Src/ow.c ****         else if (handle->rom_id_filter == handle->search.rom_id[0])
 902:Core/Src/ow.c ****         {
