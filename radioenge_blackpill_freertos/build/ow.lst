 908:Core/Src/ow.c **** 
 909:Core/Src/ow.c ****       /* update discrepancy */
 910:Core/Src/ow.c ****       handle->search.last_discrepancy = handle->search.last_zero;
 911:Core/Src/ow.c ****       handle->search.last_zero = 0;
