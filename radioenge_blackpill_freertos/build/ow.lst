 194:Core/Src/ow.c **** /*************************************************************************************************/
 195:Core/Src/ow.c **** /**
 196:Core/Src/ow.c ****  * @brief Start reading a single ROM ID from the 1-Wire bus.
 197:Core/Src/ow.c ****  * @param[in] handle: Pointer to the 1-Wire handle.
 198:Core/Src/ow.c ****  * @retval Last error code (ow_err_t)
 199:Core/Src/ow.c ****  */
 200:Core/Src/ow.c **** ow_err_t ow_update_rom_id(ow_t *handle)
 201:Core/Src/ow.c **** {
 202:Core/Src/ow.c ****   assert_param(handle != NULL);
 203:Core/Src/ow.c **** 
 204:Core/Src/ow.c ****   do
 205:Core/Src/ow.c ****   {
 206:Core/Src/ow.c ****     /* Start 1-Wire communication */
 207:Core/Src/ow.c ****     handle->error = ow_start(handle);
 208:Core/Src/ow.c ****     if (handle->error != OW_ERR_NONE)
 209:Core/Src/ow.c ****     {
 210:Core/Src/ow.c ****         /* Stop bus if start failed */
 211:Core/Src/ow.c ****         ow_stop(handle);
 212:Core/Src/ow.c ****         break;
 213:Core/Src/ow.c ****     }
 214:Core/Src/ow.c **** 
 215:Core/Src/ow.c ****     /* Set state to transfer for next operation */
 216:Core/Src/ow.c ****     handle->state = OW_STATE_XFER;
 217:Core/Src/ow.c **** 
 218:Core/Src/ow.c ****     /* Prepare buffer to read ROM command (1 byte command + 8 byte response) */
 219:Core/Src/ow.c ****     handle->buf.data[0]   = OW_CMD_READ_ROM;
 220:Core/Src/ow.c ****     handle->buf.write_len = 1;
 221:Core/Src/ow.c ****     handle->buf.read_len  = 8;
 222:Core/Src/ow.c **** 
 223:Core/Src/ow.c ****   } while (0);
 224:Core/Src/ow.c **** 
 225:Core/Src/ow.c ****   /* Return result of operation */
 226:Core/Src/ow.c ****   return handle->error;
 227:Core/Src/ow.c **** }
 228:Core/Src/ow.c **** 
 229:Core/Src/ow.c **** #else
 230:Core/Src/ow.c **** /*************************************************************************************************/
 231:Core/Src/ow.c **** /**
 232:Core/Src/ow.c ****  * @brief Start search to update all ROM IDs on the 1-Wire bus.
 233:Core/Src/ow.c ****  * @param[in] handle: Pointer to the 1-Wire handle.
 234:Core/Src/ow.c ****  * @retval Last error code (ow_err_t)
 235:Core/Src/ow.c ****  */
 236:Core/Src/ow.c **** ow_err_t ow_update_rom_id(ow_t *handle)
ARM GAS  /tmp/cc1AzyH1.s 			page 7


 237:Core/Src/ow.c **** {
 238:Core/Src/ow.c ****   assert_param(handle != NULL);
 239:Core/Src/ow.c **** 
 240:Core/Src/ow.c ****   do
 241:Core/Src/ow.c ****   {
 242:Core/Src/ow.c ****     /* Start 1-Wire communication */
 243:Core/Src/ow.c ****     handle->error = ow_start(handle);
 244:Core/Src/ow.c ****     if (handle->error != OW_ERR_NONE)
 245:Core/Src/ow.c ****     {
 246:Core/Src/ow.c ****       /* Stop bus if start failed */
 247:Core/Src/ow.c ****       ow_stop(handle);
 248:Core/Src/ow.c ****       break;
 249:Core/Src/ow.c ****     }
 250:Core/Src/ow.c **** 
 251:Core/Src/ow.c ****     /* Prepare for ROM search */
 252:Core/Src/ow.c ****     handle->state = OW_STATE_SEARCH;
 253:Core/Src/ow.c ****     handle->buf.data[0] = OW_CMD_SEARCH_ROM;
 254:Core/Src/ow.c ****     handle->rom_id_found = 0;
 255:Core/Src/ow.c **** 
 256:Core/Src/ow.c ****     /* Clear previous search and ROM ID data */
 257:Core/Src/ow.c ****     memset(&handle->search, 0, sizeof(ow_search_t));
 258:Core/Src/ow.c ****     memset(handle->rom_id, 0, sizeof(handle->rom_id));
 259:Core/Src/ow.c **** 
 260:Core/Src/ow.c ****   } while (0);
 261:Core/Src/ow.c **** 
 262:Core/Src/ow.c ****   return handle->error;
