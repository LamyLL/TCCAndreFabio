 365:Core/Src/ow.c ****     {
 366:Core/Src/ow.c ****       handle->error = OW_ERR_LEN;
 367:Core/Src/ow.c ****       ow_stop(handle);
 368:Core/Src/ow.c ****       break;
 369:Core/Src/ow.c ****     }
 370:Core/Src/ow.c **** 
 371:Core/Src/ow.c ****     /* Validate ROM ID index */
 372:Core/Src/ow.c ****     if ((handle->rom_id_found == 0) || (rom_id >= handle->rom_id_found))
 373:Core/Src/ow.c ****     {
 374:Core/Src/ow.c ****       handle->error = OW_ERR_ROM_ID;
 375:Core/Src/ow.c ****       ow_stop(handle);
 376:Core/Src/ow.c ****       break;
 377:Core/Src/ow.c ****     }
 378:Core/Src/ow.c **** 
