 139:Core/Src/ow.c **** /**
 140:Core/Src/ow.c ****  * @brief Calculate 8-bit CRC for given data.
 141:Core/Src/ow.c ****  * @param[in] data: Pointer to the data buffer.
 142:Core/Src/ow.c ****  * @param[in] len: Length of the data in bytes.
 143:Core/Src/ow.c ****  * @retval Calculated CRC8 value.
 144:Core/Src/ow.c ****  */
 145:Core/Src/ow.c **** uint8_t ow_crc(const uint8_t *data, uint16_t len)
 146:Core/Src/ow.c **** {
 147:Core/Src/ow.c ****   uint8_t crc = 0;
 148:Core/Src/ow.c ****   assert_param(data != NULL);
 149:Core/Src/ow.c ****   assert_param(len > 0);
 150:Core/Src/ow.c **** 
 151:Core/Src/ow.c ****   while (len--)
 152:Core/Src/ow.c ****   {
 153:Core/Src/ow.c ****     uint8_t inbyte = *data++;
 154:Core/Src/ow.c ****     for (uint8_t i = 8; i > 0; i--)
 155:Core/Src/ow.c ****     {
 156:Core/Src/ow.c ****       /* Compute CRC using polynomial x^8 + x^5 + x^4 + 1 (0x8C) */
 157:Core/Src/ow.c ****       uint8_t mix = (uint8_t)(crc ^ inbyte) & 0x01;
 158:Core/Src/ow.c ****       crc >>= 1;
 159:Core/Src/ow.c ****       if (mix)
 160:Core/Src/ow.c ****       {
 161:Core/Src/ow.c ****         crc ^= 0x8C;
 162:Core/Src/ow.c ****       }
 163:Core/Src/ow.c ****       inbyte >>= 1;
 164:Core/Src/ow.c ****     }
 165:Core/Src/ow.c ****   }
 166:Core/Src/ow.c ****   return crc;
 167:Core/Src/ow.c **** }
 168:Core/Src/ow.c **** 
 169:Core/Src/ow.c **** /*************************************************************************************************/
 170:Core/Src/ow.c **** /**
 171:Core/Src/ow.c ****  * @brief Check if 1-Wire bus is busy.
 172:Core/Src/ow.c ****  * @param[in] handle: Pointer to the 1-Wire handle.
 173:Core/Src/ow.c ****  * @retval true if busy, false if idle
 174:Core/Src/ow.c ****  */
 175:Core/Src/ow.c **** bool ow_is_busy(ow_t *handle)
 176:Core/Src/ow.c **** {
 177:Core/Src/ow.c ****   assert_param(handle != NULL);
 178:Core/Src/ow.c ****   return (handle->state != OW_STATE_IDLE) ? true : false;
 179:Core/Src/ow.c **** }
