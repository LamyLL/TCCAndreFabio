 346:Core/Src/ow.c ****  * @param[in] r_len Number of bytes to read into the internal buffer (can be 0).
 347:Core/Src/ow.c ****  * @retval Error code (ow_err_t).
 348:Core/Src/ow.c ****  */
 349:Core/Src/ow.c **** ow_err_t ow_xfer_by_id(ow_t *handle, uint8_t rom_id, uint8_t fn_cmd, const uint8_t *w_data, uint16_
 350:Core/Src/ow.c **** {
ARM GAS  /tmp/cc1AzyH1.s 			page 9


 351:Core/Src/ow.c ****   assert_param(handle != NULL);
 352:Core/Src/ow.c **** 
 353:Core/Src/ow.c ****   do
 354:Core/Src/ow.c ****   {
 355:Core/Src/ow.c ****     /* Check if w_data is NULL but requested write data */
 356:Core/Src/ow.c ****     if ((w_data == NULL) && (w_len > 0))
 357:Core/Src/ow.c ****     {
 358:Core/Src/ow.c ****       handle->error = OW_ERR_LEN;
