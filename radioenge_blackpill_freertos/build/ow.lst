 436:Core/Src/ow.c **** /**
 437:Core/Src/ow.c ****  * @brief Retrieve read response data from the 1-Wire buffer.
 438:Core/Src/ow.c ****  * @param[in] handle: Pointer to the 1-Wire handle.
 439:Core/Src/ow.c ****  * @param[in] data: Pointer to user buffer to store the response.
 440:Core/Src/ow.c ****  * @param[in] data_size: Size of the user buffer in bytes.
 441:Core/Src/ow.c ****  * @retval Number of bytes copied to the user buffer.
 442:Core/Src/ow.c ****  */
 443:Core/Src/ow.c **** uint16_t ow_read_resp(ow_t *handle, uint8_t *data, uint16_t data_size)
 444:Core/Src/ow.c **** {
 445:Core/Src/ow.c ****   assert_param(handle != NULL);
 446:Core/Src/ow.c ****   assert_param(data != NULL);
 447:Core/Src/ow.c **** 
 448:Core/Src/ow.c ****   uint16_t len = handle->buf.read_len;
 449:Core/Src/ow.c **** 
 450:Core/Src/ow.c ****   /* Adjust length if user buffer is smaller */
 451:Core/Src/ow.c ****   if (data_size < len)
 452:Core/Src/ow.c ****   {
 453:Core/Src/ow.c ****     len = data_size;
 454:Core/Src/ow.c ****   }
 455:Core/Src/ow.c **** 
 456:Core/Src/ow.c ****   /* Defensive: ensure we do not read past internal buffer */
 457:Core/Src/ow.c ****   if ((uint32_t)(handle->buf.write_len) + (uint32_t)len > sizeof(handle->buf.data))
 458:Core/Src/ow.c ****   {
 459:Core/Src/ow.c ****     /* Truncate to available bytes */
 460:Core/Src/ow.c ****     if (handle->buf.write_len < sizeof(handle->buf.data))
 461:Core/Src/ow.c ****     {
 462:Core/Src/ow.c ****       len = (uint16_t)(sizeof(handle->buf.data) - (uint32_t)handle->buf.write_len);
 463:Core/Src/ow.c ****     }
 464:Core/Src/ow.c ****     else
ARM GAS  /tmp/cc1AzyH1.s 			page 11


 465:Core/Src/ow.c ****     {
 466:Core/Src/ow.c ****       return 0;
 467:Core/Src/ow.c ****     }
 468:Core/Src/ow.c ****   }
 469:Core/Src/ow.c **** 
 470:Core/Src/ow.c ****   /* Copy response data from internal buffer to user buffer */
 471:Core/Src/ow.c ****   for (uint16_t idx = 0; idx < len; ++idx)
 472:Core/Src/ow.c ****   {
 473:Core/Src/ow.c ****     data[idx] = handle->buf.data[handle->buf.write_len + idx];
 474:Core/Src/ow.c ****   }
 475:Core/Src/ow.c **** 
 476:Core/Src/ow.c ****   return len;
 477:Core/Src/ow.c **** }
